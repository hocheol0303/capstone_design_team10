# 이 파일을 복사해 .env 를 만들고 실제 값으로 채우세요:  cp .env.example .env
# .env 는 .gitignore 로 제외됩니다. 실제 키를 .env.example 에 넣지 마세요.

# === LLM Provider Keys ===
OPENAI_API_KEY=sk-your-openai-api-key
GOOGLE_API_KEY=your-google-api-key
PUBMED_API_KEY=                      # (선택) 발급 시 PubMed rate limit 3→10 req/sec

# === Neo4j AuraDB ===
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=

# === Aura Agent API === (선택: Aura Agent 기능을 쓸 때만)
AURA_API_CLIENT_ID=your-aura-client-id
AURA_API_CLIENT_SECRET=your-aura-client-secret
AGENT_ID=your-agent-id

# === Embedding ===
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIMENSIONS=1536
EMBED_BATCH_SIZE=16
EMBED_MIN_BATCH_SIZE=4
EMBED_MAX_RETRIES=8
EMBED_RETRY_BASE_SECONDS=1.0

# === Misc ===
EXCEL_PATH=auradb/data/mapping_table_tmp.xlsx

# === LangSmith Tracing === (선택: 추적 비활성화하려면 LANGCHAIN_TRACING_V2=false)
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=beauty-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

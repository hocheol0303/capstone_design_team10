# === Embedding ===
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIMENSIONS=1536
EMBED_BATCH_SIZE=64
EMBED_MIN_BATCH_SIZE=8
EMBED_MAX_RETRIES=5
EMBED_RETRY_BASE_SECONDS=2

# === Misc ===

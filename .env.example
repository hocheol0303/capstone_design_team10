# === LLM Provider Keys ===
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=
PUBMED_API_KEY=

# === Neo4j AuraDB ===
NEO4J_URI=neo4j+s://...
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# === Aura Agent API ===
AURA_API_CLIENT_ID=
AURA_API_CLIENT_SECRET=
